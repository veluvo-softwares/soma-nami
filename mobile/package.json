    "@qvac/tts-ggml-android-arm64": "0.13.0",
    "@qvac/tts-ggml-ios": "0.13.0",
    "expo": "~54.0.36",
    "expo-build-properties": "1.0.10",
    "expo-device": "8.0.10",
    "expo-file-system": "19.0.24",
    "expo-font": "14.0.12",
    "expo-keep-awake": "15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
