{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.11.0",
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true
    },
    "release-apk": {
      "extends": "base",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6826935644"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6826935644"
      }
    }
  }
}
