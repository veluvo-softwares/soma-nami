{
  "expo": {
    "name": "Soma Nami",
    "slug": "soma-nami",
    "owner": "mrnyamu",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E0E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.veluvo.somanami",
      "infoPlist": {
        "NSCameraUsageDescription": "Soma Nami inatumia kamera kusoma lebo ya dawa au barua; picha haitoki kwenye simu. Soma Nami uses the camera to read a medicine label or letter aloud; the photo never leaves your phone.",
        "NSMicrophoneUsageDescription": "Soma Nami inatumia kipaza sauti ukiuliza swali kuhusu lebo; sauti yako haitoki kwenye simu. Soma Nami uses the microphone while you ask about the label; your voice never leaves your phone.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "sw": "./locales/sw.json",
      "en": "./locales/en.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "android": {
      "package": "com.veluvo.somanami",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#06101F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/AtkinsonHyperlegible-Regular.ttf",
            "./assets/fonts/AtkinsonHyperlegible-Bold.ttf"
          ]
        }
      ],
      "./plugins/withNoNativeDebugSymbols",
      "@qvac/sdk/expo-plugin"
    ],
    "extra": {
      "eas": {
        "projectId": "e9465078-6a92-40ff-8aff-3ef16137be81"
      }
    }
  }
}
